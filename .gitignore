# Secrets
.env
.env.*
!.env.example

# Personal config copies (keep examples checked in)
config/chalybclip.yaml
config/personas.yaml
config/llm.yaml
config/accounts.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover

# Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Output / scratch
out/
demo/
# ...but the landing hero ships real clip thumbnails from this static
# folder — keep it tracked despite the broad demo/ scratch rule above.
!chalybclip/api/static/demo/
scratch/
tmp/
export/
*.log
*.jsonl

# SQLite databases (Phase 1+ persistence; tenant data, never commit)
*.db
*.db-shm
*.db-wal

# Claude Code local state (worktrees, settings, etc. — developer-local)
.claude/

# One-time starter archive + the duplicate spec at the repo root
# (canonical lives at docs/chalybclip_spec.md)
/chalybclip-starter.zip
/chalybclip_spec.md

# Models / large binaries
*.bin
*.safetensors
*.ckpt
models/

# VODs / clips (any video files we accidentally commit)
*.mp4
# ...except bundled brand assets that ship with the app (the end-card outro).
!chalybclip/clip/assets/outro.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
.pgtest/

# PC worker local env (secrets)
worker.env
